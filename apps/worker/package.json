{
  "name": "@conecta/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --conditions=@conecta/source --import @swc-node/register/esm-register --watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/pg": "^8.23.1",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@conecta/db": "workspace:*",
    "pg": "^8.23.1",
    "pg-boss": "12.38.2",
    "zod": "^4.6.7"
  }
}
