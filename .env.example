# Copiá este archivo a .env y completá los valores. Nunca subas .env al repo.

# Entorno: development | test | production
NODE_ENV=development

# API
PORT=3000
# Conexión de la API (rol app_api, sin BYPASSRLS)
DATABASE_URL=postgres://app_api:CAMBIAR@localhost:5432/conecta
# Base para pruebas en CI (en local se usa embedded-postgres)
DATABASE_URL_TEST=

# Supabase Auth
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json

# Web (desarrollo): a dónde reenvía Vite las llamadas a /api
VITE_API_PROXY_TARGET=http://localhost:3000
