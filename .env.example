# Copiá este archivo a .env y completá los valores. Nunca subas .env al repo.

# Entorno: development | test | production
NODE_ENV=development

# API
PORT=3000
# Conexión de la API (rol app_api, sin BYPASSRLS)
DATABASE_URL=postgres://app_api:CAMBIAR@localhost:5432/conecta
# Opcional: conexiones máximas del pool de la API (por defecto 10)
DATABASE_POOL_MAX=
# Orígenes de la web a los que la API permite CORS, separados por coma (obligatorio en producción).
WEB_ORIGIN=http://localhost:5173
# Proxies de confianza delante de la API: false (se ignora X-Forwarded-For), true (= 1) o la
# cantidad exacta (p. ej. 1 detrás del balanceador de Railway). Nunca true sin proxy delante.
# OBLIGATORIO en producción (sin valor por defecto: la API no arranca si falta). Detrás de un proxy
# sin esto, todos los clientes comparten el límite de pedidos y la auditoría guarda la IP del proxy.
# En desarrollo y pruebas vale false si no se define.
TRUST_PROXY=false
# Opcional: pedidos por minuto y por IP antes de responder 429 (por defecto 300). Una clínica entera
# puede salir por la misma IP: dejalo holgado y que el límite por usuario sea el ajustado.
RATE_LIMIT_PER_MINUTE=
# Opcional: pedidos por minuto y por usuario autenticado antes de responder 429 (por defecto 120)
RATE_LIMIT_USER_PER_MINUTE=
# Base para pruebas en CI (en local se usa embedded-postgres). Base vacía y un rol con CREATEROLE,
# p. ej. postgresql://postgres:postgres@localhost:5432/conecta_test
DATABASE_URL_TEST=
# Rol que aplica migraciones y corre scripts de administración (en Supabase, el rol postgres).
# Lo usan `pnpm --filter @conecta/db migrar` y `sembrar-dev`. Nunca lo use la API.
DATABASE_URL_ADMIN=postgres://postgres:CAMBIAR@localhost:5432/conecta
# Opcional, solo desarrollo: id y correo del usuario de Supabase Auth local que será dueño de la
# clínica de demostración (si faltan, se usa una dueña ficticia).
SEMILLA_DUENO_ID=
SEMILLA_DUENO_EMAIL=

# Supabase Auth
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json

# Web (desarrollo): a dónde reenvía Vite las llamadas a /api
VITE_API_PROXY_TARGET=http://localhost:3000
# Web: origen de la API en el build (p. ej. https://api.conecta.com.py, sin /api/v1 ni barra final).
# Vacío = mismo origen que la web (desarrollo con el proxy de Vite, o un proxy delante en producción).
# Si es otro origen, sumalo a WEB_ORIGIN de la API (CORS) y que la API exponga Retry-After.
VITE_API_URL=

# Web: Supabase Auth en el navegador (clave publicable, no la de servicio)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CAMBIAR
